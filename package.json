{
  "name": "@kaliber/eslint-plugin",
  "bin": {
    "kaliber-eslint-migrate": "./bin/migrate-to-flat-config.js"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint --config eslint.self.config.js .",
    "lint:fix": "eslint --config eslint.self.config.js --fix .",
    "migrate": "node bin/migrate-to-flat-config.js",
    "benchmark:security": "node --expose-gc benchmarks/security.js"
  },
  "version": "2.3.0",
  "dependencies": {
    "@eslint-community/eslint-utils": "^4.9.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.0.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsx-ast-utils": "^3.3.5",
    "prop-types": "^15.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    }
  }
}
